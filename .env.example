# Audio engine behind the API. Only "mock" works in stage 2-A; "mpd" is a placeholder that answers 501.
COMET_AUDIO_ENGINE=mock
# Browser origins allowed to call the API directly (the Vite dev server proxies /api, so this is rarely needed).
COMET_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Development endpoints under /api/dev (source preview, state reset). Defaults to on for the mock engine only.
# COMET_DEV_API=1
# COMET_MPD_HOST=127.0.0.1
# COMET_MPD_PORT=6600

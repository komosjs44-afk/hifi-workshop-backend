# Audio engine behind the API: "mock" (in-memory, default) or "mpd" (a running MPD server).
COMET_AUDIO_ENGINE=mock
# Browser origins allowed to call the API directly (the Vite dev server proxies /api, so this is rarely needed).
COMET_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Development endpoints under /api/dev (source preview, state reset). Defaults to on for the mock engine only.
# COMET_DEV_API=1
# MPD connection, used when COMET_AUDIO_ENGINE=mpd. The Raspberry Pi test instance listens on 6601.
# COMET_MPD_HOST=127.0.0.1
# COMET_MPD_PORT=6600
# Seconds to wait for MPD per command (keep it below the frontend's 4 s request timeout).
# COMET_MPD_TIMEOUT=3

# Raspberry Pi (stage 2-B):
# COMET_AUDIO_ENGINE=mpd
# COMET_MPD_HOST=127.0.0.1
# COMET_MPD_PORT=6601
# COMET_DEV_API=0
